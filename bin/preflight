#!/usr/bin/env bash
# Health-check the app's data sources + env. Prints one line per source,
# ✓ green or ✗ with HTTP code. Exits 0 even when some sources are red,
# so SessionStart / hook runs don't block the session — eyeball the
# output instead.
#
# Run any time: ./bin/preflight
# Re-run after rotating a key in web/.env.local.

set -uo pipefail
cd "$(git rev-parse --show-toplevel)"

if [[ ! -f web/.env.local ]]; then
  echo "✗ web/.env.local missing — copy from a sibling worktree, then re-run."
  echo "  Hint: bin/setup-worktree"
  exit 0
fi

# Load web/.env.local without `source` so unquoted values with shell
# special chars (e.g. MAPILLARY_TOKEN=MLY|x|y, which Next.js dotenv
# reads fine but bash would split on `|`) don't get truncated. Match
# KEY=VALUE lines, strip optional wrapping quotes, export verbatim.
while IFS= read -r line || [[ -n "$line" ]]; do
  [[ -z "${line// /}" ]] && continue
  [[ "${line#"${line%%[![:space:]]*}"}" == \#* ]] && continue
  key="${line%%=*}"
  val="${line#*=}"
  [[ "$key" =~ ^[[:space:]]*[A-Za-z_][A-Za-z0-9_]*[[:space:]]*$ ]] || continue
  key="${key// /}"
  case "$val" in
    \"*\") val="${val#\"}"; val="${val%\"}" ;;
    \'*\') val="${val#\'}"; val="${val%\'}" ;;
  esac
  export "$key=$val"
done < web/.env.local

check() {
  local name="$1" code="$2"
  if [[ "$code" == "200" ]]; then
    printf "  ✓ %s\n" "$name"
  else
    printf "  ✗ %s (%s)\n" "$name" "$code"
  fi
}

echo "preflight: $(date '+%Y-%m-%d %H:%M:%S')"

check OVERPASS  "$(curl -sS -o /dev/null -w '%{http_code}' --max-time 10 -X POST \
  -A 'overlander-preflight/1.0' \
  "${OVERPASS_URL:-https://overpass-api.de/api/interpreter}" \
  --data-urlencode 'data=[out:json];out 0;')"

check WIKIPEDIA "$(curl -sS -o /dev/null -w '%{http_code}' --max-time 8 \
  https://en.wikipedia.org/api/rest_v1/page/summary/Tesla)"

check MAPILLARY "$(curl -sS -o /dev/null -w '%{http_code}' --max-time 8 \
  "https://graph.mapillary.com/images?limit=1&access_token=${MAPILLARY_TOKEN-}")"

check RIDB      "$(curl -sS -o /dev/null -w '%{http_code}' --max-time 8 \
  -H "apikey: ${RIDB_API_KEY-}" \
  'https://ridb.recreation.gov/api/v1/facilities?limit=1')"

check FOURSQUARE "$(curl -sS -o /dev/null -w '%{http_code}' --max-time 8 \
  -H "Authorization: Bearer ${FSQ_API_KEY-}" \
  -H 'X-Places-Api-Version: 2025-06-17' \
  'https://places-api.foursquare.com/places/search?ll=37.1,-113.58&radius=1000&limit=1')"

check USFS      "$(curl -sS -o /dev/null -w '%{http_code}' --max-time 8 \
  'https://apps.fs.usda.gov/arcx/rest/services/EDW/EDW_RecreationOpportunities_01/MapServer/0?f=json')"

check BLM       "$(curl -sS -o /dev/null -w '%{http_code}' --max-time 8 \
  'https://gis.blm.gov/arcgis/rest/services/recreation/BLM_Natl_Recs_pts/MapServer/23?f=json')"

check MAPBOX    "$(curl -sS -o /dev/null -w '%{http_code}' --max-time 8 \
  "https://api.mapbox.com/styles/v1/honkingsickle/cmolte3b7003e01so7msf20d3?access_token=${NEXT_PUBLIC_MAPBOX_TOKEN-}")"

# Ledger drift (read-only): flag any migration recorded on PROD's
# supabase_migrations.schema_migrations that has NO file in supabase/migrations/
# — i.e. schema pushed outside `db push`. Direct psql DDL against PROD bypasses
# the ledger (happened 2026-08-10 via a parallel Conductor worktree). Catches a
# missing FILE; will NOT catch an object created with no ledger row at all.
# Credential: an operator-managed read-only PROD conn string at
# ~/.config/overlander/prod-db-url (same pattern as staging-db-url) — never in
# the repo or shell env, and the CLI is not linked. Inert until that file exists.
prod_db_url_file="$HOME/.config/overlander/prod-db-url"
if [[ -f "$prod_db_url_file" ]] && command -v psql >/dev/null 2>&1; then
  drift=""
  while IFS= read -r v; do
    [[ -z "$v" ]] && continue
    ls supabase/migrations/"${v}"_*.sql >/dev/null 2>&1 || drift="${drift} ${v}"
  done < <(psql "$(cat "$prod_db_url_file")" -Atc \
    "select version from supabase_migrations.schema_migrations order by version" 2>/dev/null)
  if [[ -n "$drift" ]]; then
    printf "  ✗ LEDGER (PROD versions with no local file:%s )\n" "$drift"
  else
    printf "  ✓ LEDGER (every PROD migration has a repo file)\n"
  fi
else
  printf "  ◦ LEDGER (skipped — no ~/.config/overlander/prod-db-url)\n"
fi

exit 0
