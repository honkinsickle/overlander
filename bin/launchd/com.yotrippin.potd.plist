<?xml version="1.0" encoding="UTF-8"?>
<!--
  Pin of the Day — three scheduled posts a day, in local time.

  Install (from the repo root):
    cp bin/launchd/com.yotrippin.potd.plist ~/Library/LaunchAgents/
    launchctl unload ~/Library/LaunchAgents/com.yotrippin.potd.plist 2>/dev/null
    launchctl load  ~/Library/LaunchAgents/com.yotrippin.potd.plist

  Check it is registered:
    launchctl list | grep potd

  Run one now, without waiting for a slot:
    ~/Code/overlander/bin/potd-auto scenic --dry-run

  Remove:
    launchctl unload ~/Library/LaunchAgents/com.yotrippin.potd.plist

  ProgramArguments takes NO category — bin/potd-auto derives it from the clock
  hour (10 campground, 15 scenic, 20 oddities), so one job covers all three
  slots and a job that fires late after sleep finds no slot and skips.

  The path is the STABLE clone, not a Conductor workspace. Those are disposable.
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.yotrippin.potd</string>

  <key>ProgramArguments</key>
  <array>
    <string>/Users/adamwagner/Code/overlander/bin/potd-auto</string>
  </array>

  <key>StartCalendarInterval</key>
  <array>
    <dict>
      <key>Hour</key><integer>10</integer>
      <key>Minute</key><integer>0</integer>
    </dict>
    <dict>
      <key>Hour</key><integer>15</integer>
      <key>Minute</key><integer>0</integer>
    </dict>
    <dict>
      <key>Hour</key><integer>20</integer>
      <key>Minute</key><integer>0</integer>
    </dict>
  </array>

  <!-- The script writes its own timestamped log; these catch anything that
       escapes it, such as a failure to start at all. -->
  <key>StandardOutPath</key>
  <string>/Users/adamwagner/.config/overlander/potd-launchd.out</string>
  <key>StandardErrorPath</key>
  <string>/Users/adamwagner/.config/overlander/potd-launchd.err</string>

  <key>RunAtLoad</key>
  <false/>
</dict>
</plist>
